# Copy to .env and adjust. All variables are optional — these are the defaults.
# Loaded automatically by uvicorn (python-dotenv) when present.

# --- server ---
BEEWINGS_API_HOST=0.0.0.0
BEEWINGS_API_PORT=8000

# --- models ---
# Folder with alpatov12.pt / tofilski19.pt (default: ./checkpoints).
BEEWINGS_CHECKPOINTS=checkpoints
# Inference device: auto | cuda | mps | cpu
BEEWINGS_DEVICE=auto

# --- security / IO ---
# Confine server-side file paths (image_path / scan_path / out_dir) to this root.
# Leave unset to allow any path (fine for local/dev, NOT for public servers).
# BEEWINGS_DATA_ROOT=/data
# Comma-separated allowed CORS origins (default: * = any).
# BEEWINGS_CORS_ORIGINS=https://your-frontend.example
